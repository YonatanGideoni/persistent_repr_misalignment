diff --git a/models/llava/main.py b/models/llava/main.py
new file mode 100644
index 0000000..d7060fa
--- /dev/null
+++ b/models/llava/main.py
@@ -0,0 +1,79 @@
+import copy
+import warnings
+
+import torch
+from PIL import Image
+
+from llava.constants import (
+    IMAGE_TOKEN_INDEX,
+    DEFAULT_IMAGE_TOKEN,
+)
+from llava.conversation import conv_templates
+from llava.mm_utils import (
+    process_images,
+    tokenizer_image_token,
+    get_model_name_from_path,
+)
+from llava.model.builder import load_pretrained_model
+
+
+class LlavaModel:
+    def __init__(self, model_path: str, model_base: str = 'lmsys/vicuna-7b-v1.5'):
+        self.pretrained = model_path
+        self.model_name = get_model_name_from_path(model_path)
+        self.device = "cuda"
+        self.device_map = "auto"  # "auto"
+        self.max_tokens = 2048
+
+        warnings.filterwarnings("ignore")
+
+        print("Loading Llava model...")
+        print(f'Path: {self.pretrained}')
+        self.tokenizer, self.model, self.image_processor, self.max_length = (
+            load_pretrained_model(
+                self.pretrained, model_base, self.model_name, device_map=self.device_map
+            )
+        )
+
+        self.model.get_vision_tower().to(self.device)
+
+        print("Model loaded.")
+
+        self.model.eval()
+        self.model.half()
+
+    def prompt_with_images(self, prompt_text, image_paths, system_prompt=None):
+        images = [Image.open(path).convert("RGB") for path in image_paths]
+        image_tensors = process_images(images, self.image_processor, self.model.config)
+        image_tensors = [
+            _image.to(dtype=torch.float16, device=self.device)
+            for _image in image_tensors
+        ]
+
+        conv_template = "llava_v1"
+        question = DEFAULT_IMAGE_TOKEN + prompt_text
+        conv = conv_templates[conv_template].copy()
+        conv.append_message(conv.roles[0], question)
+        conv.append_message(conv.roles[1], None)
+        prompt_question = conv.get_prompt()
+
+        input_ids = (
+            tokenizer_image_token(
+                prompt_question, self.tokenizer, IMAGE_TOKEN_INDEX, return_tensors="pt"
+            )
+            .unsqueeze(0)
+            .to(self.device)
+        )
+        image_sizes = [image.size for image in images]
+
+        cont = self.model.generate(
+            input_ids,
+            images=image_tensors,
+            image_sizes=image_sizes,
+            do_sample=True,
+            max_new_tokens=self.max_tokens,
+        )
+        text_outputs = self.tokenizer.batch_decode(cont, skip_special_tokens=True)
+        print(text_outputs)
+
+        return text_outputs[0]
