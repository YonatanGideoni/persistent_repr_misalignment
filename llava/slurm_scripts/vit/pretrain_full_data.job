#!/bin/bash
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:1
#SBATCH --job-name="pretrain_full_data"
#SBATCH --output=pretrain_full_data.out
#SBATCH --error=pretrain_full_data.err

set -a; [ -f ../.env ] && source ../.env; set +a  # credentials: copy ../.env.example to ../.env

# Submit from the llava/ release root: sbatch slurm_scripts/vit/pretrain_full_data.job
# WANDB_API_KEY / HF_TOKEN / HF_HOME are read from the submitting environment.
# Data and checkpoint locations are set at the top of slurm_scripts/vit/pretrain_full_data.sh
# (DATA_DIR, CKPT_DIR, CONCEPT_TESTSET_DIR); export them to override.

export NCCL_DEBUG=INFO

srun bash slurm_scripts/vit/pretrain_full_data.sh
