#!/bin/bash
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:1
#SBATCH --job-name="finetune_heldout_concB"
#SBATCH --output=finetune_heldout_concB.out
#SBATCH --error=finetune_heldout_concB.err

set -a; [ -f ../.env ] && source ../.env; set +a  # credentials: copy ../.env.example to ../.env

# Submit from the llava/ release root: sbatch slurm_scripts/vit/finetune_heldout_concB.job
# WANDB_API_KEY / HF_TOKEN / HF_HOME are read from the submitting environment.
# Data and checkpoint locations are set at the top of slurm_scripts/vit/finetune_heldout_concB.sh
# (DATA_DIR, CKPT_DIR, CONCEPT_TESTSET_DIR); export them to override.

export NCCL_DEBUG=INFO

export CONCEPTS="broccoli,microwave,strawberry,castle,envelope"

srun bash slurm_scripts/vit/finetune_heldout_concB.sh
