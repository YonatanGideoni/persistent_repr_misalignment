#!/bin/bash
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --job-name="vlmb_eval"
#SBATCH --output=vlmb_eval.out
#SBATCH --error=vlmb_eval.err

set -a; [ -f ../.env ] && source ../.env; set +a  # credentials: copy ../.env.example to ../.env

# Submit from the llava/ release root: sbatch slurm_scripts/eval/vlmbias/eval_all.job
# Run inside the ktt_llava environment (see the repo README); credentials come from ../.env.

# Directory holding the trained llava-v1.5-7b-lora-* checkpoints
CKPT_DIR=${CKPT_DIR:-/path/to/checkpoints}

export NCCL_DEBUG=INFO
export NCCL_P2P_DISABLE=1

# dinov1b
python -m lmms_eval \
    --model llava \
    --model_args pretrained=${CKPT_DIR}/llava-v1.5-7b-lora-dinov1b,model_base=lmsys/vicuna-7b-v1.5 \
    --tasks vlms_are_biased \
    --batch_size 1 \
    --device cuda:0 \
    --log_samples \
    --log_samples_suffix dinov1b \
    --output_path ./logs/vlms_are_biased/dinov1b

# datacompclip
python -m lmms_eval \
    --model llava \
    --model_args pretrained=${CKPT_DIR}/llava-v1.5-7b-lora-datacompclip,model_base=lmsys/vicuna-7b-v1.5 \
