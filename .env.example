# Copy to .env and fill in. Job scripts source .env automatically;
# for interactive use run:  set -a; source .env; set +a

# Weights & Biases
WANDB_API_KEY=
# Optional: your W&B entity/team
# WANDB_ENTITY=

# Hugging Face, gated models+datasets require it
HF_TOKEN=
# Optional: where HF models/datasets are cached
# HF_HOME=

# Wikimedia Commons: only needed to re-scrape VisLingA images (make_dataset.py)
# Optional bot password (Special:BotPasswords) for higher rate limits
WIKIMEDIA_USER=
WIKIMEDIA_BOT_PASSWORD=
# Contact email for the API User-Agent (Wikimedia etiquette)
WIKIMEDIA_CONTACT_EMAIL=
